---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import { site, rubriques } from '../site';

interface Props {
  lang?: 'fr' | 'en';
  alternates?: { lang: string; href: string }[];
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string | null;
}

const { lang = 'fr', alternates = [], title, description = site.about, type = 'website', image } = Astro.props;
const en = lang === 'en';
const fullTitle = title ? `${title} – ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const avatarFiles = Object.keys(import.meta.glob('/public/images/avatars/*.svg')).map((file) => file.slice('/public'.length));
const pagePairs = [['/', '/en'], ['/a-propos', '/en/about'], ['/articles', '/en/articles']];
const pair = pagePairs.find((paths) => paths.includes(path.replace(/\/$/, '') || '/')) || ['/articles', '/en/articles'];
const languageUrl = (language: 'fr' | 'en') => language === lang ? path : alternates.find((item) => item.lang === language)?.href || pair[language === 'fr' ? 0 : 1];
const canonical = new URL(path, Astro.site);
const nav = en ? [['/en', 'Home'], ['/en/articles', 'Articles'], ['/en/about', 'About']] : [
  ['/', 'Accueil'],
  ['/articles', 'Articles'],
  ['/a-propos', 'À propos'],
  ['/rss.xml', 'RSS'],
];
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>try { var t = localStorage.getItem('theme'); if (t === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.lang} href={new URL(item.href, Astro.site)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#faf8f5" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{en ? 'Skip to content' : 'Aller au contenu'}</a>
    <div class="shell">
      <header class="rail">
        <div class="masthead-controls">
          <label class="sr" for="language">{en ? 'Language' : 'Langue'}</label>
          <select id="language" class="language-select">
            <option value={languageUrl('fr')} selected={!en}>FR</option>
            <option value={languageUrl('en')} selected={en}>EN</option>
          </select>
          <button class="theme-icon" type="button" id="theme" aria-label={en ? 'Enable dark mode' : 'Activer le mode sombre'}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <path class="moon" d="M20.6 14.2A8.8 8.8 0 0 1 9.8 3.4a8.8 8.8 0 1 0 10.8 10.8Z"/>
              <g class="sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></g>
            </svg>
          </button>
        </div>
        <div class="identity-block">
          <button type="button" class="avatar-ring" id="shuffle-avatar" data-faces={JSON.stringify(avatarFiles)} aria-label={en ? 'Change avatar' : 'Changer d’avatar'} title={en ? 'Change avatar' : 'Changer d’avatar'}>
            <img src="/images/avatar.svg" width="80" height="80" alt="" />
          </button>
          <div class="identity-copy">
            <a class="name" href={en ? '/en' : '/'}>{site.name}</a>
            <p class="identity-subtitle">{en ? site.subtitleEn : site.subtitle}</p>
            <SocialLinks lang={lang} />
          </div>
        </div>
        <nav aria-label={en ? "Main navigation" : "Navigation principale"}>
          {nav.map(([href, label]) => (
            <a href={href} aria-current={(href === '/' || href === '/en' ? path === href || (href === '/en' && path === '/en/') : path.startsWith(href)) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        {!en && <nav class="topics" aria-label="Rubriques">
          {Object.entries(rubriques).map(([slug, label]) => (
            <a href={`/rubriques/${slug}`} aria-current={path === `/rubriques/${slug}` ? 'page' : undefined}>{label}</a>
          ))}
        </nav>}

      </header>
      <div class="col">
        <main id="main"><slot /></main>
        <footer><span>© {new Date().getFullYear()} {site.name}</span><a href="/rss.xml">{en ? "RSS (French) ↗" : "Flux RSS ↗"}</a><a href="/installer">{en ? "Install (French) ↓" : "Installer le blog ↓"}</a></footer>
      </div>
    </div>
    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            const status = document.getElementById('offline-status');
            if (status) status.textContent = 'La lecture hors ligne n’est pas disponible pour le moment.';
          });
        });
      }
      const root = document.documentElement;
      const english = root.lang === 'en';
      const dark = () => root.dataset.theme !== 'light';
      const themeButton = document.getElementById('theme')!;
      const labelTheme = () => {
        const label = english ? (dark() ? 'Enable light mode' : 'Enable dark mode') : (dark() ? 'Activer le mode clair' : 'Activer le mode sombre');
        themeButton.setAttribute('aria-label', label);
        themeButton.title = label;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark() ? '#141414' : '#faf8f5');
      };
      labelTheme();
      document.getElementById('theme')!.addEventListener('click', () => {
        const next = dark() ? 'light' : 'dark';
        root.dataset.theme = next;
        labelTheme();
        try { localStorage.setItem('theme', next); } catch {}
      });

      document.querySelector<HTMLSelectElement>('#language')?.addEventListener('change', (event) => {
        location.assign((event.currentTarget as HTMLSelectElement).value);
      });

      const avatar = document.querySelector<HTMLImageElement>('#shuffle-avatar img')!;
      const faces: string[] = JSON.parse(document.getElementById('shuffle-avatar')!.dataset.faces || '[]');
      let previous = '';
      try { previous = sessionStorage.getItem('last-avatar') || ''; } catch {}
      const shuffle = () => {
        const choices = faces.filter((face) => face !== previous);
        if (!choices.length) return;
        previous = choices[Math.floor(Math.random() * choices.length)];
        avatar.src = previous;
        try { sessionStorage.setItem('last-avatar', previous); } catch {}
      };
      shuffle();
      document.getElementById('shuffle-avatar')!.addEventListener('click', shuffle);

      document.querySelectorAll<HTMLImageElement>('.post-preview img').forEach((img) => {
        const hideBrokenImage = () => { img.hidden = true; };
        img.addEventListener('error', hideBrokenImage);
        if (img.complete && !img.naturalWidth) hideBrokenImage();
      });

      document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy';
        button.textContent = english ? 'Copy' : 'Copier';
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
            button.textContent = english ? 'Copied' : 'Copié';
          } catch {
            button.textContent = english ? 'Copy failed' : 'Copie impossible';
          }
          setTimeout(() => (button.textContent = english ? 'Copy' : 'Copier'), 1800);
        });
        pre.append(button);
      });
    </script>
  </body>
</html>
