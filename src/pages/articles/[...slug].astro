---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import Chart from '../../components/Chart.astro';
import Cover from '../../components/Cover.astro';
import Meta from '../../components/Meta.astro';
import PostList from '../../components/PostList.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getPosts, photo } from '../../lib/posts';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const en = post.data.language === 'en';
const alternatives = post.data.translationKey?.trim() ? (await getPosts()).filter((p) => p.id !== post.id && p.data.translationKey?.trim() === post.data.translationKey?.trim() && p.data.language !== post.data.language) : [];
const { Content, headings } = await render(post);
const { cover, coverAlt, credit, audio } = post.data;
const toc = headings.filter((h) => h.depth === 2);
const related = (await getPosts(post.data.language))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category))
  .slice(0, 2);
---

<Base lang={post.data.language} alternates={[{ lang: post.data.language, href: `/articles/${post.id}` }, ...alternatives.map((p) => ({ lang: p.data.language, href: `/articles/${p.id}` }))]} title={post.data.title} description={post.data.description} type="article" image={cover && photo(cover, 1200)}>
  <article class="post">
    <header>
      {alternatives.length > 0 && <nav class="translation-switch" aria-label={en ? 'Article language' : 'Langue de l’article'}><span aria-current="page">{en ? 'English' : 'Français'}</span>{alternatives.map((p) => <a href={`/articles/${p.id}`} hreflang={p.data.language} lang={p.data.language}>{p.data.language === 'en' ? 'Read in English →' : 'Lire en français →'}</a>)}</nav>}
      <h1 class="title">{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <Meta post={post} />
      {audio && <audio controls preload="none" src={audio}></audio>}
    </header>
    {cover && (
      <figure class="hero">
        <Cover post={post} w={1600} ratio="16 / 9" eager />
        <figcaption>{coverAlt}{credit && ` Photo : ${credit}.`}</figcaption>
      </figure>
    )}
    {toc.length > 2 && (
      <nav class="toc" aria-label={en ? "In this article" : "Dans cet article"}>
        <p>{en ? 'In this article' : 'Dans cet article'}</p>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
    )}
    {(post.data.videoFile || post.data.video) && <Video url={(post.data.videoFile || post.data.video)!} title={post.data.title} />}
    <div class="prose"><Content /></div>
    {post.data.chart.length > 0 && <Chart title={post.data.chartTitle || "En chiffres"} data={post.data.chart} />}
  </article>
  {related.length > 0 && (
    <section class="related">
      <h2>{en ? 'Read next' : 'À lire ensuite'}</h2>
      <PostList posts={related} />
    </section>
  )}
  {!en && <Subscribe />}
</Base>
