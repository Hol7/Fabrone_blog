---
import { TURNSTILE_SITE_KEY } from 'astro:env/client';
---

<section class="subscribe">
  <h2>Un e-mail à chaque nouvel article</h2>
  <p class="pitch">Je t’écris quand un article paraît, pas plus. Tu peux te désabonner à tout moment.</p>
  <form method="post" action="/api/subscribe">
    <label class="sr" for="email">Adresse e-mail</label>
    <input id="email" name="email" type="email" required autocomplete="email" placeholder="ton@adresse.fr" />
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="submit">S’abonner</button>
    {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="fr"></div>}
    <p class="status" role="status" aria-live="polite"></p>
  </form>
</section>
{TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('.subscribe form')!;
  const status = form.querySelector<HTMLElement>('.status')!;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.textContent = 'Envoi en cours…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      status.textContent = (await res.json()).message;
      if (res.ok) form.reset();
    } catch {
      status.textContent = "L’inscription a échoué. Vérifie ta connexion et réessaie.";
    }
    (window as { turnstile?: { reset: () => void } }).turnstile?.reset(); // le jeton ne sert qu'une fois
  });
</script>
