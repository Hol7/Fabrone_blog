---
import Meta from './Meta.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="grid">
  {posts.map((post) => (
    <li class="card">
      <Meta post={post} compact />
      <h2><a href={`/articles/${post.id}`}>{post.data.title}</a></h2>
      <p>{post.data.description}</p>
    </li>
  ))}
</ul>
